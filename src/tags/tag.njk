---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag | tagSlug }}/"
layout: base.njk
eleventyComputed:
  # This string gets rendered once here (resolving {{ tag }}) and again when
  # base.njk outputs {{ title }} in <title>. Without `| safe` on this first
  # pass, an apostrophe in the tag name (e.g. "Zabar's") gets HTML-escaped
  # twice, showing up as the literal text "&amp;#39;" in the browser tab.
  title: "Tag: {{ tag | safe }}"
---
<p class="home-intro">tagged &ldquo;{{ tag }}&rdquo;</p>

<ul class="entry-list entry-list--home">
{% for item in collections.everything | withTag(tag) %}
  <li>
    <a href="{{ item.url | url }}">{{ item.data.title }}</a>
    <span class="entry-kind">{{ item.data.kind | kindLabel }}</span>
    <span class="entry-date">{{ item.date | readableDate }}</span>
  </li>
{% endfor %}
</ul>
