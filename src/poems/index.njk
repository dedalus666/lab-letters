---
title: Runes
layout: base.njk
pageKind: poem
---
{% import "gallery-macro.njk" as galleryMacro %}
{% import "video-macro.njk" as videoMacro %}
{% import "reader-toolbar-macro.njk" as toolbarMacro %}
{% import "icons-macro.njk" as icons %}
<div class="section-header">
  <div class="section-header-text">
    <h1>Runes</h1>
    <p class="section-subtitle">poems</p>
  </div>
  {{ icons.icon("runes", "section-icon") }}
</div>

<p class="home-intro">spell and symbols carved into letters, soaked in a brine of moss, hemp, vanilla, willow bark, and odd things that crows collect.</p>

{% set featured = collections.featured | featuredForKind(pageKind) %}
{% if featured %}
<article class="post featured-post">
  <p class="post-kind">{{ icons.icon("spotlight", "spotlight-icon") }}{{ featured.data.kind | kindLabel }} · featured</p>
  <h1>{{ featured.data.title }}</h1>
  <p class="post-date">{{ featured.date | readableDate }}</p>
  {{ galleryMacro.renderGallery(featured.data.gallery, featured.data.title) }}
  {{ videoMacro.renderVideo(featured.data.youtube, featured.data.title) }}
  {{ toolbarMacro.renderToolbar(featured.data.title, featured.data.kind, featured.date, featured.data.tags, featured.url, featured.data.note) }}
  <div class="post-body post-body-{{ featured.data.kind }}">
    {{ featured.templateContent | safe }}
  </div>
  <a class="read-more" href="{{ featured.url | url }}">permalink for this entry &rarr;</a>
</article>
{% endif %}

<ul class="entry-list">
{% for item in collections.poems | reverse %}
  {% if not featured or item.url != featured.url %}
  <li>
    <a href="{{ item.url | url }}">{{ item.data.title }}</a>
    <span class="entry-date">{{ item.date | readableDate }}</span>
  </li>
  {% endif %}
{% endfor %}
</ul>
