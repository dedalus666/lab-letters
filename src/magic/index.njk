<script>
(function () {
  var link = document.querySelector('[data-download-ledger]');
  if (!link) return;
  link.addEventListener('click', function (e) {
    var href = link.getAttribute('href');
    if (!window.fetch || !window.Blob || !window.URL || !URL.createObjectURL) return; // let the default download attribute handle it
    e.preventDefault();
    fetch(href)
      .then(function (r) { return r.blob(); })
      .then(function (blob) {
        var blobUrl = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = blobUrl;
        a.download = 'magicians-ledger.html';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(blobUrl);
      })
      .catch(function () {
        window.location.href = href;
      });
  });
})();
</script>
