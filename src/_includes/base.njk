<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    // Runs before the stylesheet paints, so there's no flash of the wrong theme.
    (function () {
      var stored = localStorage.getItem('theme');
      var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <title>{{ title }}{% if title %} · {% endif %}Labyrinthine Letters</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body class="{% if page.url == '/' %}is-home{% endif %}">
  <header class="site-header">
    <a class="site-title" href="{{ '/' | url }}">labyrinthine letters</a>
    <nav>
      <a href="{{ '/poems/' | url }}">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M8.5 4.5a3.5 3.5 0 0 0 7 0"/>
          <circle cx="12" cy="11" r="4.5"/>
          <line x1="12" y1="15.5" x2="12" y2="21"/>
          <line x1="9" y1="18.5" x2="15" y2="18.5"/>
        </svg>
        <span>runes</span>
      </a>
      <a href="{{ '/lyrics/' | url }}">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M9.5 4.5c0 1.5 1 2 2.5 2s2.5-.5 2.5-2"/>
          <line x1="12" y1="6.5" x2="12" y2="17"/>
          <line x1="9" y1="9.5" x2="15" y2="9.5"/>
          <line x1="8" y1="13" x2="16" y2="13"/>
          <path d="M8 17c0 2.5 2 3.5 4 3.5s4-1 4-3.5"/>
        </svg>
        <span>invocations</span>
      </a>
      <a href="{{ '/stories/' | url }}">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="4,9 8,6 12,9 16,6 20,9"/>
          <polyline points="4,16 8,13 12,16 16,13 20,16"/>
        </svg>
        <span>lore</span>
      </a>
      <a href="{{ '/boxes/' | url }}">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/>
          <path d="M4 7.5L12 12l8-4.5"/>
          <line x1="12" y1="12" x2="12" y2="21"/>
        </svg>
        <span>boxes</span>
      </a>
      <a href="{{ '/magic/' | url }}">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
          <rect x="6" y="6" width="12" height="12"/>
          <rect x="6" y="6" width="12" height="12" transform="rotate(45 12 12)"/>
        </svg>
        <span>arcana</span>
      </a>
      <a href="{{ '/about/' | url }}">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="9" r="4"/>
          <line x1="5" y1="13.5" x2="19" y2="13.5"/>
          <line x1="5" y1="18" x2="19" y2="18"/>
        </svg>
        <span>profile</span>
      </a>
      <div class="site-search">
        <svg class="search-icon" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="6"></circle>
          <line x1="13" y1="13" x2="18" y2="18"></line>
        </svg>
        <input type="text" id="header-search-input" class="site-search-input" placeholder="search…" autocomplete="off" aria-label="Search the archive">
        <ul class="site-search-results" id="header-search-results" hidden></ul>
      </div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle light and dark theme">◐</button>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>Art is a maze. Lose yourself.</p>
  </footer>

  <script>
    (function () {
      var btn = document.querySelector('[data-theme-toggle]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var current = document.documentElement.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    })();
  </script>

  <script>
    (function () {
      var input = document.getElementById('header-search-input');
      var results = document.getElementById('header-search-results');
      if (!input || !results) return;

      var indexUrl = "{{ '/search-index.json' | url }}";
      var data = [];
      var loaded = false;

      function ensureLoaded(cb) {
        if (loaded) { cb(); return; }
        fetch(indexUrl)
          .then(function (r) { return r.json(); })
          .then(function (json) { data = json; loaded = true; cb(); })
          .catch(function () {});
      }

      function render(matches) {
        results.innerHTML = '';
        if (!matches.length) {
          var empty = document.createElement('li');
          empty.className = 'no-results';
          empty.textContent = 'No matches.';
          results.appendChild(empty);
        } else {
          matches.slice(0, 12).forEach(function (item) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = item.url;
            a.textContent = item.title;
            li.appendChild(a);
            results.appendChild(li);
          });
        }
      }

      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        if (!q) {
          results.hidden = true;
          return;
        }
        ensureLoaded(function () {
          var matches = data.filter(function (item) {
            return item.title.toLowerCase().indexOf(q) !== -1 ||
                   item.excerpt.toLowerCase().indexOf(q) !== -1 ||
                   (item.tags || '').toLowerCase().indexOf(q) !== -1;
          });
          render(matches);
          results.hidden = false;
        });
      });

      input.addEventListener('focus', function () {
        if (input.value.trim()) results.hidden = false;
      });

      document.addEventListener('click', function (e) {
        if (!e.target.closest('.site-search')) {
          results.hidden = true;
        }
      });
    })();
  </script>
</body>
</html>
