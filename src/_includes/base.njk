<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    // Runs before the stylesheet paints, so there's no flash of the wrong theme.
    (function () {
      var stored = localStorage.getItem('theme');
      var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <title>{{ title }}{% if title %} · {% endif %}Labyrinthine Letters</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body class="{% if page.url == '/' %}is-home{% endif %}">
  <header class="site-header">
    <a class="site-title" href="{{ '/' | url }}">labyrinthine letters</a>
    <nav>
      <a href="{{ '/poems/' | url }}">runes</a>
      <a href="{{ '/lyrics/' | url }}">invocations</a>
      <a href="{{ '/stories/' | url }}">lore</a>
      <a href="{{ '/boxes/' | url }}">boxes</a>
      <a href="{{ '/magic/' | url }}">arcana</a>
      <a href="{{ '/about/' | url }}">profile</a>
      <div class="site-search">
        <svg class="search-icon" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="6"></circle>
          <line x1="13" y1="13" x2="18" y2="18"></line>
        </svg>
        <input type="text" id="header-search-input" class="site-search-input" placeholder="search…" autocomplete="off" aria-label="Search the archive">
        <ul class="site-search-results" id="header-search-results" hidden></ul>
      </div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle light and dark theme">◐</button>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>Art is a maze. Lose yourself.</p>
  </footer>

  <script>
    (function () {
      var btn = document.querySelector('[data-theme-toggle]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var current = document.documentElement.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    })();
  </script>

  <script>
    (function () {
      var input = document.getElementById('header-search-input');
      var results = document.getElementById('header-search-results');
      if (!input || !results) return;

      var indexUrl = "{{ '/search-index.json' | url }}";
      var data = [];
      var loaded = false;

      function ensureLoaded(cb) {
        if (loaded) { cb(); return; }
        fetch(indexUrl)
          .then(function (r) { return r.json(); })
          .then(function (json) { data = json; loaded = true; cb(); })
          .catch(function () {});
      }

      function render(matches) {
        results.innerHTML = '';
        if (!matches.length) {
          var empty = document.createElement('li');
          empty.className = 'no-results';
          empty.textContent = 'No matches.';
          results.appendChild(empty);
        } else {
          matches.slice(0, 12).forEach(function (item) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = item.url;
            a.textContent = item.title;
            li.appendChild(a);
            results.appendChild(li);
          });
        }
      }

      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        if (!q) {
          results.hidden = true;
          return;
        }
        ensureLoaded(function () {
          var matches = data.filter(function (item) {
            return item.title.toLowerCase().indexOf(q) !== -1 ||
                   item.excerpt.toLowerCase().indexOf(q) !== -1 ||
                   (item.tags || '').toLowerCase().indexOf(q) !== -1;
          });
          render(matches);
          results.hidden = false;
        });
      });

      input.addEventListener('focus', function () {
        if (input.value.trim()) results.hidden = false;
      });

      document.addEventListener('click', function (e) {
        if (!e.target.closest('.site-search')) {
          results.hidden = true;
        }
      });
    })();
  </script>
</body>
</html>
