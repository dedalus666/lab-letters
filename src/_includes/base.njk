<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    // Runs before the stylesheet paints, so there's no flash of the wrong theme.
    (function () {
      var stored = localStorage.getItem('theme');
      var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <title>{{ title }}{% if title %} · {% endif %}Labyrinthine Letters</title>
  {% import "icons-macro.njk" as icons %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Playfair+Display:wght@600;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="icon" type="image/png" href="{{ '/images/favicon.png' | url }}">
</head>
<body class="{% if page.url == '/' %}is-home{% endif %}">
  <header class="site-header">
    <a class="site-title" href="{{ '/' | url }}">labyrinthine letters</a>
    <nav>
      <a href="{{ '/poems/' | url }}">
        {{ icons.icon("runes", "nav-icon") }}
        <span>runes</span>
      </a>
      <a href="{{ '/lyrics/' | url }}">
        {{ icons.icon("invocations", "nav-icon") }}
        <span>invocations</span>
      </a>
      <a href="{{ '/stories/' | url }}">
        {{ icons.icon("lore", "nav-icon") }}
        <span>lore</span>
      </a>
      <a href="{{ '/boxes/' | url }}">
        {{ icons.icon("boxes", "nav-icon") }}
        <span>boxes</span>
      </a>
      <a href="{{ '/magic/' | url }}">
        {{ icons.icon("arcana", "nav-icon") }}
        <span>arcana</span>
      </a>
      <a href="{{ '/about/' | url }}">
        {{ icons.icon("profile", "nav-icon") }}
        <span>profile</span>
      </a>
      <div class="site-search">
        <svg class="search-icon" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="6"></circle>
          <line x1="13" y1="13" x2="18" y2="18"></line>
        </svg>
        <input type="text" id="header-search-input" class="site-search-input" placeholder="search…" autocomplete="off" aria-label="Search the archive">
        <ul class="site-search-results" id="header-search-results" hidden></ul>
      </div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle light and dark theme">◐</button>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-mark-group">
      <img class="footer-mark" src="{{ '/images/dedalus-mark.png' | url }}" alt="" aria-hidden="true">
      <span class="footer-sigils">
        {{ icons.icon("runes", "footer-sigil") }}
        {{ icons.icon("invocations", "footer-sigil") }}
        {{ icons.icon("arcana", "footer-sigil") }}
        {{ icons.icon("lore", "footer-sigil") }}
      </span>
    </div>
    <p>Art is a maze. Lose yourself.</p>
  </footer>

  <script>
    (function () {
      var btn = document.querySelector('[data-theme-toggle]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var current = document.documentElement.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    })();
  </script>

  <script>
    (function () {
      var input = document.getElementById('header-search-input');
      var results = document.getElementById('header-search-results');
      if (!input || !results) return;

      var indexUrl = "{{ '/search-index.json' | url }}";
      var data = [];
      var loaded = false;

      function ensureLoaded(cb) {
        if (loaded) { cb(); return; }
        fetch(indexUrl)
          .then(function (r) { return r.json(); })
          .then(function (json) { data = json; loaded = true; cb(); })
          .catch(function () {});
      }

      function render(matches) {
        results.innerHTML = '';
        if (!matches.length) {
          var empty = document.createElement('li');
          empty.className = 'no-results';
          empty.textContent = 'No matches.';
          results.appendChild(empty);
        } else {
          matches.slice(0, 12).forEach(function (item) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = item.url;
            a.textContent = item.title;
            li.appendChild(a);
            results.appendChild(li);
          });
        }
      }

      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        if (!q) {
          results.hidden = true;
          return;
        }
        ensureLoaded(function () {
          var matches = data.filter(function (item) {
            return item.title.toLowerCase().indexOf(q) !== -1 ||
                   item.excerpt.toLowerCase().indexOf(q) !== -1 ||
                   (item.tags || '').toLowerCase().indexOf(q) !== -1;
          });
          render(matches);
          results.hidden = false;
        });
      });

      input.addEventListener('focus', function () {
        if (input.value.trim()) results.hidden = false;
      });

      document.addEventListener('click', function (e) {
        if (!e.target.closest('.site-search')) {
          results.hidden = true;
        }
      });
    })();
  </script>
  <script>
    // Click-to-zoom for inline images in posts that set `bodyClass: zoom-images`.
    (function () {
      var images = document.querySelectorAll('.zoom-images img');
      if (!images.length) return;

      var MAX_ZOOM = 6, CLICK_ZOOM = 2.5;
      var overlay = document.createElement('div');
      overlay.className = 'zoom-overlay';
      overlay.hidden = true;
      overlay.innerHTML =
        '<div class="zoom-controls">' +
        '<button type="button" data-zoom-out aria-label="Zoom out">&minus;</button>' +
        '<button type="button" data-zoom-in aria-label="Zoom in">+</button>' +
        '<button type="button" data-zoom-close aria-label="Close">&times;</button>' +
        '</div>' +
        '<div class="zoom-stage"><img alt=""></div>';
      document.body.appendChild(overlay);

      var stage = overlay.querySelector('.zoom-stage');
      var img = stage.querySelector('img');
      var zoom = 1, baseW = 0, baseH = 0;

      function fit() {
        var ar = (img.naturalWidth || 1) / (img.naturalHeight || 1);
        baseW = Math.min(window.innerWidth * 0.92, window.innerHeight * 0.9 * ar);
        baseH = baseW / ar;
      }

      // Resize to a new zoom level, keeping the point (fx, fy) — in viewport
      // coordinates — under the same spot of the image.
      function setZoom(next, fx, fy) {
        next = Math.max(1, Math.min(MAX_ZOOM, next));
        var rect = img.getBoundingClientRect();
        if (fx === undefined) { fx = window.innerWidth / 2; fy = window.innerHeight / 2; }
        var rx = rect.width ? Math.max(0, Math.min(1, (fx - rect.left) / rect.width)) : 0.5;
        var ry = rect.height ? Math.max(0, Math.min(1, (fy - rect.top) / rect.height)) : 0.5;
        zoom = next;
        var w = baseW * zoom, h = baseH * zoom;
        img.style.width = w + 'px';
        img.style.height = h + 'px';
        stage.classList.toggle('is-zoomed', zoom > 1);
        var left = Math.max(0, (stage.clientWidth - w) / 2);
        var top = Math.max(0, (stage.clientHeight - h) / 2);
        stage.scrollLeft = left + rx * w - fx;
        stage.scrollTop = top + ry * h - fy;
      }

      function open(source) {
        img.alt = source.alt || '';
        var show = function () {
          fit();
          zoom = 1;
          setZoom(1);
          overlay.hidden = false;
          document.body.classList.add('lightbox-open');
          stage.scrollLeft = 0;
          stage.scrollTop = 0;
        };
        img.onload = show;
        img.src = source.currentSrc || source.src;
        if (img.complete && img.naturalWidth) show();
      }

      function close() {
        overlay.hidden = true;
        document.body.classList.remove('lightbox-open');
      }

      images.forEach(function (source) {
        source.tabIndex = 0;
        source.setAttribute('role', 'button');
        source.addEventListener('click', function () { open(source); });
        source.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(source); }
        });
      });

      // Click toggles between fit-to-screen and zoomed in; a drag pans.
      var drag = null;
      stage.addEventListener('pointerdown', function (e) {
        drag = { x: e.clientX, y: e.clientY, left: stage.scrollLeft, top: stage.scrollTop, moved: false };
        stage.setPointerCapture(e.pointerId);
      });
      stage.addEventListener('pointermove', function (e) {
        if (!drag) return;
        var dx = e.clientX - drag.x, dy = e.clientY - drag.y;
        if (Math.abs(dx) + Math.abs(dy) > 4) drag.moved = true;
        if (drag.moved && zoom > 1) {
          stage.classList.add('is-dragging');
          stage.scrollLeft = drag.left - dx;
          stage.scrollTop = drag.top - dy;
        }
      });
      stage.addEventListener('pointerup', function (e) {
        var wasDrag = drag && drag.moved;
        drag = null;
        stage.classList.remove('is-dragging');
        if (wasDrag) return;
        if (e.target !== img) { close(); return; } // click on the dark backdrop
        if (zoom > 1) setZoom(1); else setZoom(CLICK_ZOOM, e.clientX, e.clientY);
      });

      stage.addEventListener('wheel', function (e) {
        if (!e.ctrlKey && !e.metaKey) return; // plain scroll pans a zoomed image
        e.preventDefault();
        setZoom(zoom * Math.exp(-e.deltaY * 0.01), e.clientX, e.clientY);
      }, { passive: false });

      overlay.querySelector('[data-zoom-in]').addEventListener('click', function () { setZoom(zoom * 1.5); });
      overlay.querySelector('[data-zoom-out]').addEventListener('click', function () { setZoom(zoom / 1.5); });
      overlay.querySelector('[data-zoom-close]').addEventListener('click', close);

      document.addEventListener('keydown', function (e) {
        if (overlay.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === '+' || e.key === '=') setZoom(zoom * 1.5);
        if (e.key === '-' || e.key === '_') setZoom(zoom / 1.5);
        if (e.key === '0') setZoom(1);
      });

      window.addEventListener('resize', function () {
        if (overlay.hidden) return;
        fit();
        setZoom(zoom);
      });
    })();
  </script>
</body>
</html>
