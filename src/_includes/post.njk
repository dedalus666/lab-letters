---
layout: base.njk
---
{% import "gallery-macro.njk" as galleryMacro %}
{% import "video-macro.njk" as videoMacro %}
{% import "reader-toolbar-macro.njk" as toolbarMacro %}
{% set sectionMap = {
  "poem": { url: "/poems/", label: "Runes" },
  "lyric": { url: "/lyrics/", label: "Invocations" },
  "story": { url: "/stories/", label: "Lore" },
  "box": { url: "/boxes/", label: "Boxes" }
} %}
{% set section = sectionMap[kind] %}
{% set extra = tags | extraTags(kind) %}
{% if section %}
<a class="breadcrumb" href="{{ section.url | url }}">&larr; back to {{ section.label }}</a>
{% endif %}

<article class="post">
  <p class="post-kind">{{ kind | kindLabel }}</p>
  <h1>{{ title }}</h1>
  <p class="post-date">{{ date | readableDate }}</p>

  {{ toolbarMacro.renderToolbar(title, kind, date, tags, page.url, note) }}

  {{ galleryMacro.renderGallery(gallery, title) }}
  {{ videoMacro.renderVideo(youtube, title) }}

  <div class="post-body">
    {{ content | safe }}
  </div>
  {% if extra.length %}
  <ul class="tag-list post-tags">
    {% for tag in extra %}
      <li><a href="{{ ('/tags/' + (tag | tagSlug) + '/') | url }}">#{{ tag }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
  <div class="post-footer">
    <button class="share-button" type="button" data-copy-link>share</button>
    <span class="share-feedback" data-copy-feedback aria-live="polite"></span>
  </div>
</article>

<script>
(function () {
  var article = document.currentScript.previousElementSibling;
  if (!article) return;

  var btn = article.querySelector('[data-copy-link]');
  var feedback = article.querySelector('[data-copy-feedback]');
  if (!btn) return;
  btn.addEventListener('click', function () {
    navigator.clipboard.writeText(window.location.href).then(function () {
      feedback.textContent = 'link copied';
      setTimeout(function () { feedback.textContent = ''; }, 2000);
    }).catch(function () {
      feedback.textContent = 'copy failed — copy from address bar';
    });
  });
})();
</script>
