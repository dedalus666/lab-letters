{# The six mythic-symbol icons, one per section, shared between the header
   nav (small) and each section page's own heading (large). Keeping the
   path data in one place means both spots always stay in sync. #}
{% macro icon(name, cssClass) %}
{% if name == "runes" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
  <path d="M8.5 4.5a3.5 3.5 0 0 0 7 0"/>
  <circle cx="12" cy="11" r="4.5"/>
  <line x1="12" y1="15.5" x2="12" y2="21"/>
  <line x1="9" y1="18.5" x2="15" y2="18.5"/>
</svg>
{% elif name == "invocations" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
  <path d="M9.5 4.5c0 1.5 1 2 2.5 2s2.5-.5 2.5-2"/>
  <line x1="12" y1="6.5" x2="12" y2="17"/>
  <line x1="9" y1="9.5" x2="15" y2="9.5"/>
  <line x1="8" y1="13" x2="16" y2="13"/>
  <path d="M8 17c0 2.5 2 3.5 4 3.5s4-1 4-3.5"/>
</svg>
{% elif name == "lore" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <polyline points="4,9 8,6 12,9 16,6 20,9"/>
  <polyline points="4,16 8,13 12,16 16,13 20,16"/>
</svg>
{% elif name == "boxes" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/>
  <path d="M4 7.5L12 12l8-4.5"/>
  <line x1="12" y1="12" x2="12" y2="21"/>
</svg>
{% elif name == "arcana" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
  <rect x="6" y="6" width="12" height="12"/>
  <rect x="6" y="6" width="12" height="12" transform="rotate(45 12 12)"/>
</svg>
{% elif name == "profile" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
  <circle cx="12" cy="9" r="4"/>
  <line x1="5" y1="13.5" x2="19" y2="13.5"/>
  <line x1="5" y1="18" x2="19" y2="18"/>
</svg>
{% elif name == "piranesi" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M3 3h18v18H3V7h14v10H7V11h6"/>
</svg>
{% elif name == "lord-jim" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <circle cx="12" cy="5" r="2"/>
  <line x1="12" y1="7" x2="12" y2="21"/>
  <line x1="7" y1="11" x2="17" y2="11"/>
  <path d="M5 15a7 7 0 0 0 7 6 7 7 0 0 0 7-6"/>
</svg>
{% elif name == "sun" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
  <circle cx="12" cy="12" r="4"/>
  <line x1="12" y1="2" x2="12" y2="5"/>
  <line x1="12" y1="19" x2="12" y2="22"/>
  <line x1="2" y1="12" x2="5" y2="12"/>
  <line x1="19" y1="12" x2="22" y2="12"/>
  <line x1="4.5" y1="4.5" x2="6.5" y2="6.5"/>
  <line x1="17.5" y1="17.5" x2="19.5" y2="19.5"/>
  <line x1="4.5" y1="19.5" x2="6.5" y2="17.5"/>
  <line x1="17.5" y1="6.5" x2="19.5" y2="4.5"/>
</svg>
{% elif name == "note" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M9 18V5l10-2v13"/>
  <circle cx="6" cy="18" r="3"/>
  <circle cx="16" cy="16" r="3"/>
</svg>
{% elif name == "tv" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M10 6l-3-4"/>
  <path d="M14 6l3-4"/>
  <path d="M9 8a3 3 0 0 1 6 0"/>
  <rect x="3" y="8" width="18" height="11" rx="1.5"/>
  <circle cx="7.5" cy="19.5" r="1"/>
  <circle cx="16.5" cy="19.5" r="1"/>
</svg>
{% elif name == "key" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <circle cx="7" cy="7" r="4"/>
  <line x1="10" y1="10" x2="21" y2="21"/>
  <line x1="15" y1="15" x2="18" y2="12"/>
  <line x1="18" y1="18" x2="21" y2="15"/>
</svg>
{% elif name == "rocket" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <g transform="rotate(40 12 12)">
    <path d="M12 2c2.5 3 3.5 7 3.5 11H8.5c0-4 1-8 3.5-11z"/>
    <circle cx="12" cy="8" r="1.3"/>
    <path d="M8.5 10.5L5 14.5h3.5"/>
    <path d="M15.5 10.5L19 14.5h-3.5"/>
    <path d="M10 13c-.3 2 .3 4 2 6 1.7-2 2.3-4 2-6"/>
  </g>
</svg>
{% elif name == "branch" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <circle cx="6" cy="6" r="2.5"/>
  <circle cx="6" cy="18" r="2.5"/>
  <circle cx="18" cy="12" r="2.5"/>
  <path d="M8.2 7.2L15.8 10.8"/>
  <path d="M8.2 16.8L15.8 13.2"/>
</svg>
{% elif name == "activity" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M6 3h12"/>
  <path d="M6 21h12"/>
  <path d="M7 3c0 4 3 5.5 5 6.5-2 1-5 2.5-5 6.5"/>
  <path d="M17 3c0 4-3 5.5-5 6.5 2 1 5 2.5 5 6.5"/>
</svg>
{% elif name == "everything" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M7 9c-2.2 0-4 1.6-4 3.6S4.8 16 7 16c2.5 0 3.5-1.4 5-3.4M17 9c2.2 0 4 1.6 4 3.6S19.2 16 17 16c-2.5 0-3.5-1.4-5-3.4"/>
  <path d="M12 12.6C10.5 10.6 9.5 9 7 9M12 12.4c1.5 2 2.5 3.6 5 3.6"/>
</svg>
{% elif name == "spotlight" %}
<svg class="{{ cssClass }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true">
  <path d="M12 2c.6 3.6 1.6 6.4 3 7.8 1.4 1.4 4.2 2.4 7 3-2.8.6-5.6 1.6-7 3-1.4 1.4-2.4 4.2-3 7.8-.6-3.6-1.6-6.4-3-7.8-1.4-1.4-4.2-2.4-7-3 2.8-.6 5.6-1.6 7-3 1.4-1.4 2.4-4.2 3-7.8z"/>
</svg>
{% endif %}
{% endmacro %}
